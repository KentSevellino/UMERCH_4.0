{
  "expo": {
    "name": "UMerch",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/UM/umerch-logo.png",
    "scheme": "umerchapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.umerch.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#B00000",
        "foregroundImage": "./assets/images/UM/umerch-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/UM/umerch-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#B00000",
          "image": "./assets/images/UM/umerch-logo.png",
          "imageWidth": 76,
          "iosUrlScheme": "com.googleusercontent.apps.1062751030517-iqlb6uepf9njvqht2t6hjufd7fgemctn"
        }
      ],
      "expo-status-bar",
      "expo-image",
      "expo-web-browser",
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f6c99efb-6d35-45bb-90ef-a2915a6c4bb1"
      }
    }
  }
}
