# .easignore
# Used by EAS Build instead of .gitignore when present.
# NOTE: EAS archives from the GIT REPOSITORY ROOT, so these patterns are
# relative to the repo root, and must NOT use trailing slashes for directories
# (a trailing slash makes `.git/` fail to match `.git` and the whole .git dir
# gets uploaded).

# Git metadata (must be excluded, otherwise the entire history is uploaded)
.git

# Only the `mobile/` Expo app is needed for this build
frontend
backend
.opencode

# Dependencies and build output (at any depth)
node_modules
dist
web-build
.expo

# Native directories (managed workflow -> EAS runs prebuild)
android
ios

# Expo / TS generated
expo-env.d.ts
*.tsbuildinfo

# Native credentials
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Metro & debug
metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*

# OS
.DS_Store

# Local env files
.env*.local
